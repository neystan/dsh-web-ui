{
  "name": "@neystan/dsh-web-ui-all",
  "description": "DSH Web UI 全家桶聚合插件：一键安装全部功能插件（task-board / git-graph / pet / aionui-panel / describe-image / compat shim）+ 皮肤全家桶（dsh-skins，皮肤资产内置）。设置卡片使用 DSH rc.7 官方 keyed settings slot。",
  "version": "0.1.16",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/neystan/dsh-web-ui.git"
  },
  "dependencies": {
    "@neystan/dsh-client-ui-aionui-panel": "workspace:*",
    "@neystan/dsh-client-ui-task-board": "workspace:*",
    "@neystan/dsh-client-ui-git-graph": "workspace:*",
    "@neystan/dsh-pet": "workspace:*",
    "@neystan/dsh-tool-describe-image": "workspace:*",
    "@neystan/dsh-skins": "workspace:*",
    "@neystan/dsh-client-ui-skin-center": "workspace:*"
  },
  "author": {
    "name": "neystan",
    "url": "https://github.com/neystan"
  },
  "contributors": [
    {
      "name": "zhu1090093659 (Original author)",
      "url": "https://github.com/zhu1090093659"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
