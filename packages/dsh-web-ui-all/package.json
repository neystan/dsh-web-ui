{
  "name": "@neystan/dsh-web-ui-all",
  "description": "DSH Web UI 全家桶聚合插件：一键安装全部功能插件（task-board / git-graph / pet / aionui-panel / web-ui-settings / describe-image / compat shim）+ 皮肤全家桶（dsh-skins，皮肤资产内置）。compat 桥接层已并入本包（src/client），无需独立 compat npm 包。",
  "version": "0.1.15",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "Apache-2.0",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/neystan/dsh-web-ui.git"
  },
  "dependencies": {
    "@neystan/dsh-client-ui-aionui-panel": "workspace:*",
    "@neystan/dsh-client-ui-task-board": "workspace:*",
    "@neystan/dsh-client-ui-git-graph": "workspace:*",
    "@neystan/dsh-pet": "workspace:*",
    "@neystan/dsh-tool-describe-image": "workspace:*",
    "@neystan/dsh-client-ui-web-ui-settings": "workspace:*",
    "@neystan/dsh-skins": "workspace:*",
    "@neystan/dsh-client-ui-skin-center": "workspace:*"
  },
  "author": {
    "name": "neystan",
    "url": "https://github.com/neystan"
  },
  "contributors": [
    {
      "name": "zhu1090093659 (Original author)",
      "url": "https://github.com/zhu1090093659"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
